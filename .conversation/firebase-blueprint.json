{
  "entities": {
    "User": {
      "title": "User",
      "description": "DOIT Network Registered User",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "provider", "admin"] },
        "accountStatus": { "type": "string", "enum": ["ACTIVE", "SUSPENDED", "PENDING_DELETION"] }
      },
      "required": ["uid", "email", "role"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Hyperlocal service booking record in BHEL Township",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "providerId": { "type": "string" },
        "serviceCategoryId": { "type": "string" },
        "amountInRupees": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["PREPAID", "COD"] },
        "paymentStatus": { "type": "string", "enum": ["PENDING", "PROCESSING", "PAID", "FAILED", "REFUNDED"] },
        "status": { "type": "string" }
      },
      "required": ["id", "customerId", "serviceCategoryId", "paymentMethod", "paymentStatus"]
    },
    "WalletTransaction": {
      "title": "WalletTransaction",
      "description": "Immutable ledger transaction for service provider internal balance",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "providerId": { "type": "string" },
        "bookingId": { "type": "string" },
        "type": { "type": "string", "enum": ["COMMISSION_DEBIT", "REFUND_DEBIT", "PENALTY", "INTEREST", "PAYOUT", "ADJUSTMENT", "BONUS", "CREDIT", "REVERSAL"] },
        "amount": { "type": "number" },
        "balanceBefore": { "type": "number" },
        "balanceAfter": { "type": "number" },
        "description": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "providerId", "type", "amount"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "entity": "User"
    },
    "/bookings/{bookingId}": {
      "entity": "Booking"
    },
    "/wallet_transactions/{txId}": {
      "entity": "WalletTransaction"
    }
  }
}
